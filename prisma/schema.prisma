generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Waiter {
  id     String  @id @default(uuid())
  name   String
  tables Table[]

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("waiters")
}

model Sector {
  id       String  @id @default(uuid())
  name     String
  // orden en que se muestran los sectores (0 = primero); lo define el usuario arrastrando
  position Int     @default(0)
  tables   Table[]

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // el nombre es único dentro de cada negocio, no en toda la base
  @@unique([tenantId, name])
  @@map("sectors")
}

model MenuItem {
  id       String  @id @default(uuid())
  name     String
  price    Float
  quantity Int     @default(1)
  isPromo  Boolean @default(false)
  orders   Order[]

  // opcional: un plato sin categoría se trata como de cocina
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([categoryId])
  @@map("menu_items")
}

model Table {
  id        String  @id @default(uuid())
  // orden fijo de las mesas: sin esto Postgres las devuelve en orden físico y una mesa
  // editada (al ocuparla) saltaba al final de la lista
  seq       Int     @default(autoincrement())
  name      String
  available Boolean @default(true)

  waiterId String?
  waiter   Waiter? @relation(fields: [waiterId], references: [id], onDelete: SetNull)

  // sector opcional; si se elimina el sector, la mesa queda "sin sector"
  sectorId String?
  sector   Sector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)

  // una mesa "hija" tiene un solo controlador; un controlador puede tener muchas hijas
  controlledById String?
  controlledBy   Table?  @relation("TableHierarchy", fields: [controlledById], references: [id], onDelete: SetNull)
  linkedTables   Table[] @relation("TableHierarchy")

  orders Order[]

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tables")
}

model Order {
  id      String @id @default(uuid())
  tableId String
  table   Table  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  quantity Int    @default(1)
  note     String @default("")

  // estado en cocina; updatedAt se mueve al cambiar de estado (sirve para "listo hace X")
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt

  @@map("orders")
}

enum Role {
  ADMIN
  CASHIER
  WAITER
  KITCHEN
  BAR
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("users")
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
}

// Un negocio (restaurante). Todos los datos del sistema cuelgan de un Tenant, y la API
// filtra siempre por el tenantId del usuario logueado.
model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  // Datos para tickets y comandas
  legalName    String  @default("")
  taxIdLabel   String  @default("CUIT")
  taxId        String  @default("")
  address      String  @default("")
  city         String  @default("")
  postalCode   String  @default("")
  phone        String  @default("")
  ticketFooter String  @default("")
  logoUrl      String?

  // Formato de dinero
  currencyCode String @default("ARS")
  locale       String @default("es-AR")

  // Hora (0-23) en que arranca cada turno
  shiftMorningStart   Int @default(6)
  shiftAfternoonStart Int @default(12)
  shiftNightStart     Int @default(18)

  // Plan contratado: define qué funciones están disponibles (ver src/plans/plans.ts).
  plan            String  @default("pro")
  // El negocio elige si manda todo a cocina (false) o separa cocina y barra (true).
  // Solo tiene efecto si el plan incluye la función.
  splitKitchenBar Boolean @default(false)

  waiters    Waiter[]
  sectors    Sector[]
  menuItems  MenuItem[]
  categories Category[]
  tables     Table[]
  sales      Sale[]
  users      User[]

  @@map("tenants")
}

// Una venta = el cobro de una mesa. Es inmutable: guarda el detalle de lo vendido con los
// precios de ese momento, así los reportes no cambian si después se edita el menú.
model Sale {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Lo genera el navegador al abrir el cobro: si el mismo cobro llega dos veces
  // (doble toque, reintento tras un corte) se devuelve la misma venta en vez de duplicarla.
  checkoutId String

  tableName     String
  waiterName    String
  // quién cobró; vacío en las ventas migradas del sistema anterior
  cashierName   String @default("")
  paymentMethod String

  grossTotal        Float // suma de precio x cantidad, sin descuentos
  discountTotal     Float @default(0) // todo lo descontado (por ítem + general)
  globalDiscountPct Float @default(0)
  totalAmount       Float // lo que se cobró

  date  DateTime   @default(now())
  items SaleItem[]

  @@unique([tenantId, checkoutId])
  @@index([tenantId, date])
  @@map("sales")
}

model SaleItem {
  id     String @id @default(uuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  name        String
  unitPrice   Float
  quantity    Int
  note        String  @default("")
  isPromo     Boolean @default(false)
  discountPct Float   @default(0)
  // precio x cantidad con el descuento del ítem (todavía sin el descuento general)
  lineTotal   Float

  @@index([saleId])
  @@map("sale_items")
}

enum Destination {
  KITCHEN
  BAR
}

// Agrupa los platos del menú. Si el negocio separa cocina y barra, el destino de la
// categoría decide en qué pantalla aparece cada plato pedido.
model Category {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  position    Int         @default(0)
  destination Destination @default(KITCHEN)

  menuItems MenuItem[]

  @@unique([tenantId, name])
  @@map("categories")
}
