generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Waiter {
  id     String  @id @default(uuid())
  name   String
  tables Table[]

  @@map("waiters")
}

model Sector {
  id       String  @id @default(uuid())
  name     String  @unique
  // orden en que se muestran los sectores (0 = primero); lo define el usuario arrastrando
  position Int     @default(0)
  tables   Table[]

  @@map("sectors")
}

model MenuItem {
  id       String  @id @default(uuid())
  name     String
  price    Float
  quantity Int     @default(1)
  isPromo  Boolean @default(false)
  orders   Order[]

  @@map("menu_items")
}

model Table {
  id        String  @id @default(uuid())
  // orden fijo de las mesas: sin esto Postgres las devuelve en orden físico y una mesa
  // editada (al ocuparla) saltaba al final de la lista
  seq       Int     @default(autoincrement())
  name      String
  available Boolean @default(true)

  waiterId String?
  waiter   Waiter? @relation(fields: [waiterId], references: [id], onDelete: SetNull)

  // sector opcional; si se elimina el sector, la mesa queda "sin sector"
  sectorId String?
  sector   Sector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)

  // una mesa "hija" tiene un solo controlador; un controlador puede tener muchas hijas
  controlledById String?
  controlledBy   Table?  @relation("TableHierarchy", fields: [controlledById], references: [id], onDelete: SetNull)
  linkedTables   Table[] @relation("TableHierarchy")

  orders Order[]

  @@map("tables")
}

model Order {
  id      String @id @default(uuid())
  tableId String
  table   Table  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  quantity Int    @default(1)
  note     String @default("")

  // estado en cocina; updatedAt se mueve al cambiar de estado (sirve para "listo hace X")
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt

  @@map("orders")
}

model Balance {
  id            String   @id @default(uuid())
  orderId       String   @unique
  tableName     String
  waiterName    String
  totalAmount   Float
  paymentMethod String
  date          DateTime @default(now())

  @@map("balances")
}

enum Role {
  ADMIN
  CASHIER
  WAITER
  KITCHEN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("users")
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
}
