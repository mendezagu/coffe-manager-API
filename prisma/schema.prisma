generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Waiter {
  id     String  @id @default(uuid())
  name   String
  tables Table[]

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("waiters")
}

model Sector {
  id       String  @id @default(uuid())
  name     String
  // orden en que se muestran los sectores (0 = primero); lo define el usuario arrastrando
  position Int     @default(0)
  tables   Table[]

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // el nombre es único dentro de cada negocio, no en toda la base
  @@unique([tenantId, name])
  @@map("sectors")
}

model MenuItem {
  id       String  @id @default(uuid())
  name     String
  price    Float
  quantity Int     @default(1)
  isPromo  Boolean @default(false)
  // true = viene de la plantilla de ejemplo y todavía no se tocó
  isExample Boolean @default(false)
  // fijado como favorito: aparece primero en la caja del mostrador
  isFavorite Boolean @default(false)
  // false = el plato no se muestra en la carta online ni en el pedido por QR (el personal lo sigue viendo)
  visibleInMenu Boolean @default(true)
  // foto del plato: clave del archivo en el almacenamiento (la dirección pública se arma al mostrarla)
  imageKey   String?
  // carta: descripción corta, etiqueta sobre la foto (con su color) y si va en "Destacados"
  description String?
  badge       String?
  badgeColor  String  @default("terracotta")
  featured    Boolean @default(false)
  orders   Order[]

  // opcional: un plato sin categoría se trata como de cocina
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  modifierGroups MenuItemModifierGroup[]
  optionPrices   MenuItemOptionPrice[]
  ingredients    MenuItemIngredient[]

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([categoryId])
  @@map("menu_items")
}

model Table {
  id        String    @id @default(uuid())
  // orden fijo de las mesas: sin esto Postgres las devuelve en orden físico y una mesa
  // editada (al ocuparla) saltaba al final de la lista
  seq       Int       @default(autoincrement())
  name      String
  available Boolean   @default(true)
  // cuándo se cargó el primer pedido de la mesa abierta (null = libre); se borra al liberarla
  openedAt  DateTime?

  waiterId String?
  waiter   Waiter? @relation(fields: [waiterId], references: [id], onDelete: SetNull)

  // sector opcional; si se elimina el sector, la mesa queda "sin sector"
  sectorId String?
  sector   Sector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)

  // una mesa "hija" tiene un solo controlador; un controlador puede tener muchas hijas
  controlledById String?
  controlledBy   Table?  @relation("TableHierarchy", fields: [controlledById], references: [id], onDelete: SetNull)
  linkedTables   Table[] @relation("TableHierarchy")

  orders Order[]

  // Pedido por QR: el código secreto va dentro del QR de la mesa (se regenera si se filtra); el código
  // de mesa de 4 dígitos es opcional y cambia cada vez que la mesa se libera.
  qrToken String? @unique
  qrPin   String  @default("")

  qrRequests   QrOrderRequest[]
  serviceCalls ServiceCall[]

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  reservations Reservation[]

  @@map("tables")
}

model Order {
  id      String @id @default(uuid())
  tableId String
  table   Table  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  quantity Int    @default(1)
  note     String @default("")

  // estado en cocina; updatedAt se mueve al cambiar de estado (sirve para "listo hace X")
  status OrderStatus @default(PENDING)

  // Modificadores elegidos: [{ groupId, group, optionId, name, priceDelta }]. Es una copia del
  // momento del pedido, así editar o borrar el modificador después no cambia lo ya pedido.
  modifiers Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("orders")
}

enum Role {
  ADMIN
  CASHIER
  WAITER
  KITCHEN
  BAR
}

model User {
  id           String   @id @default(uuid())
  // Nombre de usuario (puede ser un email): único dentro de cada local, no en toda la plataforma
  email        String
  name         String
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  // La contraseña la puso otra persona (por ejemplo, el alta desde la consola): tiene que cambiarla antes de usar la app
  mustChangePassword Boolean @default(false)
  // Cuándo se cambió la contraseña por última vez: las sesiones abiertas antes de ese momento dejan de valer
  passwordChangedAt DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
}

// Un negocio (restaurante). Todos los datos del sistema cuelgan de un Tenant, y la API
// filtra siempre por el tenantId del usuario logueado.
model Tenant {
  id        String   @id @default(uuid())
  name      String
  // Código con el que el personal identifica al local al ingresar (junto a su usuario). Único en toda la plataforma.
  loginCode String   @unique @default(uuid())
  createdAt DateTime @default(now())

  // Datos para tickets y comandas
  legalName    String  @default("")
  taxIdLabel   String  @default("CUIT")
  taxId        String  @default("")
  address      String  @default("")
  city         String  @default("")
  postalCode   String  @default("")
  phone        String  @default("")
  ticketFooter String  @default("")
  logoUrl      String?
  // Color de marca de las pantallas que ven los clientes (carta QR y reservas): #RRGGBB
  brandColor   String  @default("#1b2822")

  // Formato de dinero
  currencyCode String @default("ARS")
  locale       String @default("es-AR")

  // Hora (0-23) en que arranca cada turno
  shiftMorningStart   Int @default(6)
  shiftAfternoonStart Int @default(12)
  shiftNightStart     Int @default(18)

  // Plan contratado: define qué funciones están disponibles (ver src/plans/plans.ts).
  plan            String  @default("pro")
  // Funciones sueltas que se suman al plan (ej: Mostrador en un plan Esencial). Las pone la Consola.
  addons          String[] @default([])
  // Cómo vende el negocio: both | counter | tables. Solo define qué partes de la app se muestran.
  salesMode       String  @default("both")
  // El negocio elige si manda todo a cocina (false) o separa cocina y barra (true).
  // Solo tiene efecto si el plan incluye la función.
  // Pantalla de cocina (estados de los pedidos, comandas): el negocio decide si la usa. Apagada por defecto.
  kitchenEnabled  Boolean @default(false)
  splitKitchenBar Boolean @default(false)

  // Propinas: el negocio decide si las ofrece al cobrar y qué porcentaje sugiere
  // si el cajero puede aplicar descuentos al cobrar (el administrador siempre puede)
  cashierDiscounts      Boolean @default(false)
  // quién más puede eliminar ítems de una orden (el administrador siempre puede): los mozos, los cajeros, ambos o ninguno
  waiterCanRemoveItems  Boolean @default(false)
  cashierCanRemoveItems Boolean @default(false)
  tipEnabled            Boolean @default(false)
  tipSuggestedPct       Int     @default(10)

  // Comisión para los mozos por las mesas que atendieron: el administrador la habilita y fija el porcentaje.
  // Se calcula sobre lo vendido (sin propina). Cada venta guarda el porcentaje vigente al cobrar.
  commissionEnabled     Boolean @default(false)
  commissionPct         Float   @default(0)

  // Zona horaria del local: las reservas se guardan en hora local del negocio (día + minutos desde la medianoche)
  timezone String @default("America/Argentina/Buenos_Aires")

  // Reservas: el negocio las habilita y define sus reglas. La página pública es /reservar/<reservationSlug>.
  // Carta online: una dirección pública (/carta/<menuSlug>) para ver el menú sin pedir ni código
  // imágenes de la carta: portada (banda de arriba) y fondo de la página, guardadas como clave del archivo
  coverImageKey      String?
  backgroundImageKey String?
  // cuánto se ve cada imagen (0 a 100); null = automático (lo decide el sistema)
  coverIntensity      Int?
  backgroundIntensity Int?
  menuPublicEnabled Boolean @default(false)
  menuSlug          String? @unique

  reservationsEnabled    Boolean @default(false)
  reservationSlug        String? @unique
  reservationOpenMin     Int     @default(720) // primer horario reservable (minutos desde la medianoche; 720 = 12:00)
  reservationCloseMin    Int     @default(1380) // último horario reservable (1380 = 23:00)
  reservationDays        Int[]   @default([0, 1, 2, 3, 4, 5, 6]) // días de la semana en que se reserva (0 = domingo)
  reservationSlotMin     Int     @default(30) // cada cuántos minutos hay un horario para elegir
  reservationDurationMin Int     @default(90) // cuánto tiempo ocupa una mesa una reserva
  reservationCapacity    Int     @default(30) // personas sentadas a la vez como máximo
  reservationMaxParty    Int     @default(10) // personas máximas por reserva
  reservationAdvanceDays Int     @default(30) // con cuántos días de anticipación se puede reservar
  reservationNoticeMin   Int     @default(60) // anticipación mínima, en minutos

  // Caja: si es true, no se puede cobrar sin una caja abierta
  requireOpenRegister Boolean @default(true)

  // Inventario: el negocio decide si lo usa (y el plan debe incluirlo). Si bloquea, un plato sin insumos
  // suficientes no se puede pedir; si no bloquea, solo se avisa.
  inventoryEnabled Boolean @default(false)
  blockOutOfStock  Boolean @default(true)

  // Pedido por QR: el negocio decide si lo ofrece (y el plan debe incluirlo), si el pedido entra solo o
  // lo confirma un mozo, y si hace falta el código de mesa.
  qrEnabled      Boolean @default(false)
  qrAutoConfirm  Boolean @default(false)
  qrRequirePin   Boolean @default(false)
  // Asistente de primeros pasos: false hasta que el dueño lo termina o lo saltea (los negocios que ya existían arrancan en true)
  onboardingDone Boolean @default(false)

  // Cuándo se comenzó el turno actual. Lo ven todos los dispositivos del negocio: el Balance y el Inicio cuentan desde acá.
  // Null: todavía no se comenzó ninguno. El historial completo está siempre en Reportes.
  shiftStartedAt DateTime?
  // Caja abierta en este momento (una por negocio). Es única: así dos aperturas simultáneas no pueden coexistir.
  openRegisterId String? @unique

  waiters        Waiter[]
  sectors        Sector[]
  menuItems      MenuItem[]
  categories     Category[]
  modifierGroups ModifierGroup[]
  tables         Table[]
  sales          Sale[]
  cashRegisters  CashRegister[]
  stockItems     StockItem[]
  stockMovements StockMovement[]
  qrRequests     QrOrderRequest[]
  serviceCalls   ServiceCall[]
  users          User[]
  hotelPartners  HotelPartner[]
  hotelVouchers  HotelVoucher[]
  reservations   Reservation[]
  waitlist       WaitlistEntry[]

  @@map("tenants")
}

// Una venta = el cobro de una mesa. Es inmutable: guarda el detalle de lo vendido con los
// precios de ese momento, así los reportes no cambian si después se edita el menú.
model Sale {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Lo genera el navegador al abrir el cobro: si el mismo cobro llega dos veces
  // (doble toque, reintento tras un corte) se devuelve la misma venta en vez de duplicarla.
  checkoutId String

  tableName     String
  waiterName    String
  // quién cobró; vacío en las ventas migradas del sistema anterior
  cashierName   String @default("")
  // método de la venta: el único usado, o "mixto" si se pagó con más de uno (el detalle está en payments)
  paymentMethod String

  grossTotal        Float // suma de precio x cantidad, sin descuentos
  discountTotal     Float @default(0) // todo lo descontado (por ítem + general)
  globalDiscountPct Float @default(0)
  totalAmount       Float // lo que se vendió (sin propina)
  // propina: se cobra junto con la cuenta pero NO es venta (no suma a la facturación) y es del mozo
  tipAmount         Float @default(0)
  // porcentaje de comisión del mozo que regía al cobrar (0 si el negocio no la tenía activada); no cambia si después se ajusta
  commissionPct     Float @default(0)

  date          DateTime   @default(now())
  // cuándo se pidió lo primero en la mesa; solo en el cobro que la libera (sirve para la permanencia promedio)
  tableOpenedAt DateTime?
  // dónde se vendió: en una mesa o en el mostrador (sin mesa ni mozo); en el mostrador, takeaway = para llevar
  source        String     @default("mesa")
  takeaway      Boolean    @default(false)
  items         SaleItem[]
  payments      Payment[]

  // caja en la que se cobró (null en las ventas anteriores al control de caja)
  registerId String?
  register   CashRegister? @relation(fields: [registerId], references: [id], onDelete: SetNull)

  // voucher de hotel canjeado en este cobro (uno por mesa) y hotel del que venía el cliente
  voucherId String?       @unique
  voucher   HotelVoucher? @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  hotelId   String?
  hotel     Hotel?        @relation(fields: [hotelId], references: [id], onDelete: SetNull)

  @@unique([tenantId, checkoutId])
  @@index([tenantId, date])
  @@index([registerId])
  @@index([hotelId])
  @@map("sales")
}

model SaleItem {
  id     String @id @default(uuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  name        String
  unitPrice   Float
  quantity    Int
  note        String  @default("")
  isPromo     Boolean @default(false)
  discountPct Float   @default(0)
  // precio x cantidad con el descuento del ítem (todavía sin el descuento general)
  lineTotal   Float

  // Costo de una unidad al momento de la venta (insumos de la receta x su costo). null = el plato no tenía
  // receta, o el negocio no usaba inventario: no se puede calcular la ganancia.
  unitCost Float?

  // Mismos modificadores que tenía la orden. unitPrice ya incluye sus precios.
  modifiers Json @default("[]")

  @@index([saleId])
  @@map("sale_items")
}

enum Destination {
  KITCHEN
  BAR
}

// Agrupa los platos del menú. Si el negocio separa cocina y barra, el destino de la
// categoría decide en qué pantalla aparece cada plato pedido.
model Category {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  position    Int         @default(0)
  destination Destination @default(KITCHEN)
  // true = viene de la plantilla de ejemplo y todavía no se tocó
  isExample   Boolean     @default(false)
  // carta: subtítulo de la sección, texto corto a la derecha del título y cómo se muestran sus platos (grid | list | hero)
  subtitle    String?
  tagline     String?
  layout      String      @default("grid")

  menuItems MenuItem[]

  @@unique([tenantId, name])
  @@map("categories")
}

enum ModifierSelection {
  SINGLE // se elige una sola opción (ej: tamaño)
  MULTIPLE // se pueden elegir varias (ej: extras)
}

// Grupo de opciones que se ofrece al pedir un plato: "Tamaño", "Leche", "Extras".
// Un grupo se reutiliza en muchos platos (el mismo "Leche" para todos los cafés).
model ModifierGroup {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String
  selection ModifierSelection @default(SINGLE)
  // obligatorio: el mozo no puede agregar el plato sin elegir (ej: el punto de la carne)
  required  Boolean           @default(false)
  position  Int               @default(0)

  options ModifierOption[]
  items   MenuItemModifierGroup[]

  @@unique([tenantId, name])
  @@map("modifier_groups")
}

model ModifierOption {
  id String @id @default(uuid())

  groupId String
  group   ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  name       String
  // lo que suma (o resta) al precio del plato; 0 si no cambia el precio
  priceDelta Float   @default(0)
  position   Int     @default(0)
  // desactivar una opción la oculta del menú sin tocar lo ya pedido (ej: "se acabó la leche de almendras")
  active     Boolean @default(true)

  ingredients ModifierOptionIngredient[]
  itemPrices  MenuItemOptionPrice[]

  @@index([groupId])
  @@map("modifier_options")
}

// Qué grupos ofrece cada plato
model MenuItemModifierGroup {
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  groupId String
  group   ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  position Int @default(0)

  @@id([menuItemId, groupId])
  @@index([groupId])
  @@map("menu_item_modifier_groups")
}

// Precio propio de una opción en un plato: "Lágrima" Chico $3800, Jarro $4000... mientras otro plato
// tiene otros precios para los mismos tamaños. Guarda el PRECIO FINAL del plato con esa opción
// (sin fila, la opción suma su priceDelta general al precio del plato).
model MenuItemOptionPrice {
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  optionId String
  option   ModifierOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  price Float

  @@id([menuItemId, optionId])
  @@index([optionId])
  @@map("menu_item_option_prices")
}

// Un pago de una venta. Una cuenta puede pagarse con varios métodos (pago mixto) y,
// en efectivo, registra cuánto entregó el cliente y el vuelto.
model Payment {
  id String @id @default(uuid())

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  method   String
  // lo que se aplicó a la cuenta (más propina) con este método; es lo que entra a la caja
  amount   Float
  // solo efectivo: lo que entregó el cliente y el vuelto (tendered - amount)
  tendered Float?
  change   Float  @default(0)

  @@index([saleId])
  @@map("payments")
}

// Turno de caja: se abre con un fondo de efectivo y se cierra contando lo que hay (arqueo).
model CashRegister {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  openedAt      DateTime @default(now())
  openedByName  String
  openingAmount Float

  closedAt       DateTime?
  closedByName   String?
  // al cerrar: lo que el sistema calculó, lo que el cajero contó y la diferencia (contado - esperado)
  expectedAmount Float?
  countedAmount  Float?
  difference     Float?
  note           String    @default("")

  movements CashMovement[]
  sales     Sale[]

  @@index([tenantId, openedAt])
  @@map("cash_registers")
}

enum CashMovementType {
  IN // ingreso de efectivo (ej: cambio que traen)
  OUT // retiro o gasto (ej: pago a un proveedor)
}

model CashMovement {
  id String @id @default(uuid())

  registerId String
  register   CashRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)

  type      CashMovementType
  amount    Float
  reason    String
  createdBy String
  createdAt DateTime         @default(now())

  @@index([registerId])
  @@map("cash_movements")
}

enum StockMovementType {
  PURCHASE // entrada de mercadería
  SALE // consumo por una venta
  WASTE // merma: rotura, vencimiento, error
  ADJUSTMENT // ajuste o conteo físico
}

// Algo que se cuenta: un insumo (café, leche, vasos) o un producto que se vende tal cual (una gaseosa).
model StockItem {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  // unidad de medida: se carga y se descuenta siempre en esta unidad (unidad, g, kg, ml, l)
  unit        String   @default("unidad")
  // existencias actuales; puede quedar negativo si se vendió sin stock (hay un aviso)
  onHand      Float    @default(0)
  minStock    Float    @default(0)
  // costo por unidad de medida (promedio ponderado de las compras)
  costPerUnit Float    @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  movements         StockMovement[]
  menuIngredients   MenuItemIngredient[]
  optionIngredients ModifierOptionIngredient[]

  @@unique([tenantId, name])
  @@map("stock_items")
}

// Libro de movimientos: cada cambio de existencias queda registrado (qué, cuánto, quién, por qué).
model StockMovement {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  type         StockMovementType
  // variación: positiva si entra, negativa si sale
  quantity     Float
  balanceAfter Float
  // solo compras: costo por unidad de esa compra
  unitCost     Float?
  supplier     String            @default("")
  note         String            @default("")
  // id de la venta que lo originó (type = SALE)
  reference    String?
  createdBy    String
  createdAt    DateTime          @default(now())

  @@index([tenantId, createdAt])
  @@index([stockItemId, createdAt])
  @@map("stock_movements")
}

// Receta: lo que consume UNA unidad de un plato.
model MenuItemIngredient {
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  quantity Float

  @@id([menuItemId, stockItemId])
  @@index([stockItemId])
  @@map("menu_item_ingredients")
}

// Lo que consume elegir una opción (ej: "Leche de almendras" consume leche de almendras
// y reemplaza a la leche común de la receta).
model ModifierOptionIngredient {
  id String @id @default(uuid())

  optionId String
  option   ModifierOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  quantity            Float
  // si viene, esa parte de la receta deja de consumirse (la opción la reemplaza)
  replacesStockItemId String?

  @@unique([optionId, stockItemId])
  @@index([stockItemId])
  @@map("modifier_option_ingredients")
}

enum QrRequestStatus {
  PENDING // esperando que un mozo lo confirme
  CONFIRMED // el mozo lo confirmó: ya es una orden de la mesa
  REJECTED // el mozo lo rechazó (con motivo)
  CANCELLED // el cliente lo canceló antes de que lo confirmaran
}

// Un pedido hecho por el cliente desde el QR de la mesa. No es una orden hasta que se confirma.
model QrOrderRequest {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  tableId String
  table   Table  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  // Lo genera cada celular: así cada cliente ve solo sus pedidos, sin tener que registrarse.
  clientId     String
  customerName String @default("")

  // [{ menuItemId, name, quantity, note, optionIds, modifiers, unitPrice }]: copia de lo pedido y de los precios
  items Json
  // total estimado al momento del pedido
  total Float

  status       QrRequestStatus @default(PENDING)
  rejectReason String          @default("")
  // órdenes de la mesa que se crearon o ampliaron al confirmar (para mostrarle al cliente cómo avanza)
  orderIds     Json            @default("[]")

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolvedBy String?

  @@index([tenantId, status])
  @@index([tableId, createdAt])
  @@map("qr_order_requests")
}

enum ServiceCallType {
  WAITER // "llamar al mozo"
  BILL // "pedir la cuenta"
}

enum ServiceCallStatus {
  OPEN
  DONE
}

// Aviso del cliente desde su celular: llamar al mozo o pedir la cuenta.
model ServiceCall {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  tableId String
  table   Table  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  type   ServiceCallType
  status ServiceCallStatus @default(OPEN)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolvedBy String?

  @@index([tenantId, status])
  @@index([tableId, status])
  @@map("service_calls")
}

// ---------------------------------------------------------------------------------------------
// Hoteles aliados. Un hotel NO pertenece a un negocio: lo comparten varios restaurantes.
// Flujo: el huésped escanea el QR del hotel, ve los restaurantes adheridos, elige uno y recibe un
// voucher (código corto) para ESE restaurante; en el cobro el restaurante lo canjea (uno por mesa).
// ---------------------------------------------------------------------------------------------
model Hotel {
  id               String   @id @default(uuid())
  name             String
  // va en la URL pública del hotel (/hotel/:slug)
  slug             String   @unique
  // código vigente que el hotel le da a sus huéspedes; se cambia cuando se quiere (ej. cada semana)
  accessCode       String
  contact          String   @default("")
  active           Boolean  @default(true)
  // días que dura un voucher desde que el huésped lo pide
  voucherValidDays Int      @default(3)
  createdAt        DateTime @default(now())

  partners HotelPartner[]
  vouchers HotelVoucher[]
  sales    Sale[]
  users    HotelUser[]
  reservations Reservation[]

  @@map("hotels")
}

// Un restaurante adherido a un hotel, con el descuento que ofrece a sus huéspedes
model HotelPartner {
  id          String  @id @default(uuid())
  hotelId     String
  hotel       Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  discountPct Float
  active      Boolean @default(true)
  // condiciones que se muestran al huésped (ej. "De lunes a jueves")
  conditions  String  @default("")

  @@unique([hotelId, tenantId])
  @@index([tenantId])
  @@map("hotel_partners")
}

enum VoucherStatus {
  ISSUED
  REDEEMED
  CANCELLED
}

model HotelVoucher {
  id           String        @id @default(uuid())
  // código que se muestra y se dicta en el restaurante (sin caracteres que se confunden)
  code         String        @unique
  hotelId      String
  hotel        Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guestName    String
  // el descuento queda fijo al pedir el voucher, aunque después el restaurante lo cambie
  discountPct  Float
  status       VoucherStatus @default(ISSUED)
  validFrom    DateTime      @default(now())
  validTo      DateTime
  createdAt    DateTime      @default(now())
  redeemedAt   DateTime?
  // Documento del huésped (DNI o pasaporte). No se guarda el número: solo una huella cifrada con una clave del
  // servidor (sirve para reconocer al mismo huésped) y los últimos 3 caracteres (para que el cajero lo compruebe).
  // Los vouchers anteriores a este dato quedan en null y siguen funcionando.
  guestDocHash String?
  guestDocHint String?
  sale         Sale?
  reservation  Reservation?

  @@index([hotelId, status])
  @@index([tenantId, status])
  @@index([hotelId, guestDocHash])
  @@map("hotel_vouchers")
}

// ---------------------------------------------------------------------------------------------
// Reservas de mesa. La fecha y la hora van en hora LOCAL del negocio (día "YYYY-MM-DD" + minutos desde la
// medianoche): así no dependen de la zona horaria de quien reserva ni de la del servidor.
// ---------------------------------------------------------------------------------------------
enum ReservationStatus {
  PENDING // esperando que el local la confirme (si no confirma sola)
  CONFIRMED
  ARRIVED // el cliente llegó
  NO_SHOW // no vino
  CANCELLED
}

enum ReservationSource {
  WEB // desde la página pública del restaurante
  MANUAL // la cargó el personal (teléfono, WhatsApp, en persona)
  HOTEL // la hizo un huésped desde la pantalla de su hotel
}

model Reservation {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  date      String // YYYY-MM-DD, hora local del negocio
  startMin  Int // minutos desde la medianoche local
  partySize Int

  guestName  String
  guestPhone String // solo dígitos
  guestEmail String @default("")
  notes      String @default("")

  status ReservationStatus @default(CONFIRMED)
  source ReservationSource @default(WEB)
  // código corto que ve el cliente (sirve para cancelar su reserva junto con su teléfono)
  code   String

  // mesa asignada al recibirlo (opcional)
  tableId String?
  table   Table?  @relation(fields: [tableId], references: [id], onDelete: SetNull)

  // reserva hecha por un huésped: de qué hotel viene y el voucher que sacó junto con la reserva (si lo pidió)
  hotelId   String?
  hotel     Hotel?        @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  voucherId String?       @unique
  voucher   HotelVoucher? @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime?

  @@unique([tenantId, code])
  @@index([tenantId, date])
  @@index([tenantId, guestPhone])
  @@map("reservations")
}

enum WaitlistStatus {
  WAITING
  CONTACTED // el local ya le avisó que hay lugar
  BOOKED // terminó en una reserva
  CANCELLED
}

// Alguien que quiere ir un día en un rango de horas y no había lugar: queda anotado para avisarle si se libera.
model WaitlistEntry {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  date       String // YYYY-MM-DD
  fromMin    Int // rango de horas en el que le sirve ir
  toMin      Int
  partySize  Int
  guestName  String
  guestPhone String

  status    WaitlistStatus @default(WAITING)
  hotelId   String?
  createdAt DateTime       @default(now())

  @@index([tenantId, date, status])
  @@map("waitlist_entries")
}

// Acceso del hotel a su propio portal (cambiar su código, ver cuántos vouchers se usaron).
// Es una cuenta aparte de User: no pertenece a ningún negocio y su token no sirve en el resto de la API.
model HotelUser {
  id           String   @id @default(uuid())
  hotelId      String
  hotel        Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  email        String   @unique
  name         String
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([hotelId])
  @@map("hotel_users")
}

// Dueño (y equipo) de Tavolapp: cuentas de la consola de plataforma. No pertenecen a ningún negocio ni hotel,
// y su token no sirve en ninguna otra parte de la API.
model PlatformUser {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("platform_users")
}

// Pedidos que el servidor ya procesó, para no repetirlos si el mismo envío llega dos veces (doble clic, un reintento
// de la red o de un proxy). Por ahora lo usa "agregar platos a una mesa"; las claves se borran después de un par de días.
model IdempotencyKey {
  key       String   @id
  tenantId  String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("idempotency_keys")
}
