DATABASE_URL="postgresql://user:password@localhost:5432/coffee_manager?schema=public"
PORT=3000

# Obligatorio: mínimo 32 caracteres (generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Primer admin: solo se usa si la tabla users está vacía
ADMIN_EMAIL=hotel@gmail.com
ADMIN_PASSWORD=password1234

# Orígenes permitidos por CORS, separados por coma (vacío = abierto, solo para desarrollo)
CORS_ORIGINS=

# Fotos de los platos (Cloudflare R2). Sin estas variables, la subida de fotos queda apagada.
# Los valores reales van SOLO en tu .env y en Render, nunca acá.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
